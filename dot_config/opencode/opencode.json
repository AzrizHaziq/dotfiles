{
  "$schema": "https://opencode.ai/config.json",
  "agent": {
    "build": {
      "color": "primary",
      "description": "Execute the smallest correct change",
      "mode": "primary",
      "permission": {
        "skill": {
          "caveman": "allow",
          "caveman-commit": "allow",
          "caveman-help": "allow"
        }
      },
      "prompt": "Execute directly after building context. Make the smallest correct change, preserve project patterns, avoid unnecessary abstractions, and verify the result when practical. Keep responses concise and factual. Use the caveman skill when the user asks for extreme brevity or token efficiency. Use the caveman-commit skill when the user asks for commit-message help.",
      "temperature": 0.2
    },
    "explore": {
      "color": "secondary",
      "description": "Read-only codebase exploration and summarization",
      "mode": "subagent",
      "permission": {
        "skill": {
          "caveman": "allow",
          "caveman-help": "allow",
          "find-skills": "allow"
        }
      },
      "prompt": "Explore broadly, prefer search over guesswork, stay read-only in spirit, and return concise summaries with specific file references. Use the caveman skill when the user asks for extreme brevity or token efficiency. Use the find-skills skill when the user asks about available skills or how to extend capabilities.",
      "steps": 3,
      "temperature": 0.1
    },
    "plan": {
      "color": "info",
      "description": "Inspect first and produce a concrete plan",
      "mode": "primary",
      "permission": {
        "skill": {
          "caveman": "allow",
          "caveman-help": "allow",
          "find-skills": "allow"
        }
      },
      "prompt": "Inspect and plan first. Search and read before deciding. Be concise. Produce actionable plans, assumptions, and risks. Ask only short clarifying questions when ambiguity blocks a correct solution. Do not rush into edits when planning is more appropriate. Use the caveman skill when the user asks for extreme brevity or token efficiency. Use the find-skills skill when the user asks about available skills or how to extend capabilities.",
      "temperature": 0.2
    }
  },
  "command": {
    "llm-login": {
      "description": "Run local llm-login CLI for ecosystem setup",
      "template": ""
    },
    "llmadmin": {
      "description": "Admin helper for Konekasa LLM settings and user limits",
      "template": ""
    }
  },
  "default_agent": "plan",
  "disabled_providers": [
    "opencode",
    "opencode-go"
  ],
  "instructions": [
    "/home/azrizhaziq/.config/opencode/instructions.md"
  ],
  "mcp": {
    "atlassian": {
      "enabled": false,
      "headers": {
        "Authorization": "Bearer {env:JIRA_OPENCODE_PAT}"
      },
      "oauth": false,
      "type": "remote",
      "url": "https://mcp.atlassian.com/v1/mcp"
    },
    "context7": {
      "enabled": true,
      "headers": {
        "CONTEXT7_API_KEY": "YOUR_API_KEY"
      },
      "type": "remote",
      "url": "https://mcp.context7.com/mcp"
    },
    "figma": {
      "command": [
        "npx",
        "-y",
        "figma-developer-mcp",
        "--stdio"
      ],
      "enabled": false,
      "environment": {
        "FIGMA_API_KEY": "{env:FIGMA_API_KEY}"
      },
      "type": "local"
    },
    "github": {
      "enabled": false,
      "headers": {
        "Authorization": "Bearer {env:GITHUB_MCP_PAT}",
        "X-MCP-Readonly": "true",
        "X-MCP-Toolsets": "context,users,orgs,repos,issues,pull_requests"
      },
      "oauth": false,
      "type": "remote",
      "url": "https://api.githubcopilot.com/mcp/"
    }
  },
  "permission": {
    "skill": {
      "*": "ask"
    }
  },
