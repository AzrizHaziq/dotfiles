{
  "$schema": "https://opencode.ai/tui.json",
  "keybinds": {
    "agent_cycle": ["alt+m", "tab"],
    "leader": "ctrl+o",
    "messages_half_page_down": "ctrl+d",
    "messages_half_page_up": "ctrl+u",
    "session_list": "<leader>s",
    "session_timeline": "<leader>shift+t",
    "status_view": "<leader>shift+s",
    "variant_cycle": "none",
    "variant_list": "alt+t",
    "prompt.autocomplete.select": ["return", "ctrl+y"],
    "plugin_manager": "<leader>p"
  },
  "plugin": []
}
