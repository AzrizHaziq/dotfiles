# Docker CLI completions:
# Docker Desktop can install zsh completion files under ~/.docker/completions.
# Adding that directory to fpath lets `compinit` load completions for commands like `docker` and `docker compose`.
if [ -d "$HOME/.docker/completions" ]; then
  fpath=("$HOME/.docker/completions" $fpath)
fi

# Faster compinit with cache validation - only run once per day
autoload -Uz compinit
local dump_file="${ZDOTDIR:-$HOME}/.zcompdump"

# Only run compinit once a day (check if dump file is older than 24h)
if [[ -n $dump_file(#qNmh-24) ]]; then
  compinit -C -d "$dump_file"  # Use cache, skip check
else
  compinit -d "$dump_file"     # Full check once per day
  # Compile dump file in background for next time
  { zcompile "$dump_file" } &!
fi

export PATH="$HOME/.local/bin:$PATH"
export PATH="/home/azrizhaziq/.bun/bin:$PATH"

# Keep a sane PATH in all environments and remove duplicates.
typeset -U path PATH
path=(
  /home/linuxbrew/.linuxbrew/bin
  /home/linuxbrew/.linuxbrew/sbin
  "$HOME/.local/bin"
  "$HOME/.bun/bin"
  /usr/local/sbin
  /usr/local/bin
  /usr/sbin
  /usr/bin
  /sbin
  /bin
  $path
)
export PATH

