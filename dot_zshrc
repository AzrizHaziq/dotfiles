# zmodload zsh/zprof

# If you come from bash you might have to change your $PATH.
# export PATH=$HOME/bin:$HOME/.local/bin:/usr/local/bin:$PATH

# Load zsh-defer early for deferred command execution
source ~/.oh-my-zsh/custom/plugins/zsh-defer/zsh-defer.plugin.zsh

# Path to your Oh My Zsh installation.
export ZSH="$HOME/.oh-my-zsh"

# Set name of the theme to load --- if set to "random", it will
# load a random theme each time Oh My Zsh is loaded, in which case,
# to know which specific one was loaded, run: echo $RANDOM_THEME
# See https://github.com/ohmyzsh/ohmyzsh/wiki/Themes
ZSH_THEME=""

fpath+=("$(brew --prefix)/share/zsh/site-functions")
autoload -U promptinit; promptinit
prompt pure

# Uncomment the following line to use case-sensitive completion.
# CASE_SENSITIVE="true"

# Uncomment the following line to use hyphen-insensitive completion.
# Case-sensitive completion must be off. _ and - will be interchangeable.
# HYPHEN_INSENSITIVE="true"

# Uncomment one of the following lines to change the auto-update behavior
# zstyle ':omz:update' frequency 7

# Uncomment the following line if you want to disable marking untracked files
# under VCS as dirty. This makes repository status check for large repositories
# much, much faster.
# DISABLE_UNTRACKED_FILES_DIRTY="true"

# Uncomment the following line if you want to change the command execution time
# stamp shown in the history command output.
# You can set one of the optional three formats:
# "mm/dd/yyyy"|"dd.mm.yyyy"|"yyyy-mm-dd"
# or set a custom format using the strftime function format specifications,
# see 'man strftime' for details.
# HIST_STAMPS="mm/dd/yyyy"

# HISTFILE =~/.zsh_history
HISTSIZE=70000
SAVEHIST=70000

setopt HIST_IGNORE_SPACE # Don't save when prefixed with space
setopt HIST_IGNORE_DUPS  # Don't save duplicate lines
setopt SHARE_HISTORY     # Share history between sessions

plugins=(
  zsh-vi-mode
  git
  colored-man-pages
)

if [ -d "$HOME/.oh-my-zsh" ]; then
  source "$ZSH/oh-my-zsh.sh"
fi

eval "$(zoxide init zsh)"
eval "$(mise activate zsh)"

ZSH_AUTOSUGGEST_BUFFER_MAX_SIZE="20"
ZSH_AUTOSUGGEST_USE_ASYNC=1

# Load heavy plugins with zsh-defer for optimal startup performance
# These load sequentially after prompt appears, with proper keyboard input handling
zsh-defer +2 bindkey '^P' history-substring-search-up
zsh-defer +2 bindkey '^N' history-substring-search-down
zsh-defer +2 bindkey '^Y' autosuggest-accept
zsh-defer +2 source $ZSH/custom/plugins/zsh-syntax-highlighting/zsh-syntax-highlighting.plugin.zsh
zsh-defer +2 source $ZSH/custom/plugins/zsh-fzf-history-search/zsh-fzf-history-search.plugin.zsh
zsh-defer +2 source $ZSH/custom/plugins/zsh-autosuggestions/zsh-autosuggestions.zsh
zsh-defer +2 source $ZSH/custom/plugins/you-should-use/you-should-use.plugin.zsh
zsh-defer +2 source $ZSH/custom/plugins/zsh-history-substring-search/zsh-history-substring-search.plugin.zsh
zsh-defer +2 source $ZSH/custom/plugins/fzf-tab/fzf-tab.zsh # Load fzf-tab LAST to bind widgets after all other plugins

# User configuration
# export MANPATH="/usr/local/man:$MANPATH"

# You may need to manually set your language environment
# export LANG=en_US.UTF-8

export EDITOR='nvim'
export VISUAL='nvim'

# bindkey -s '^Xgc' 'git commit -m ""\C-b' ## ctrl+x+g+c
alias pn="pnpm"
alias y="yarn"
alias omz="omz update"

alias wdd="cd /mnt/c/Repos"
alias wd="cd /home/azrizhaziq/work"

alias cat="bat"
alias ls="eza --icons=always --color=always --group-directories-first" # General replacement for 'ls'
alias ll="eza --long --header --icons=always --git --group-directories-first" # Detailed list view mapped to 'll'
alias lt="ll --tree --level=2"

alias v="nvim"
alias vim="nvim"

alias cd="z"
alias gs="git status"
alias c="clear"
alias s="du -hs * | sort -rh | head -5" # sort by size
alias grep="grep --color=auto -n" # colorize grep output
alias hs="history | grep --color=auto -n" # colorize history output
alias gip="curl ipinfo.io/ip && curl ipinfo.io/org" # get ip and org
alias f="find . -name" # find files
alias zshreset="source ~/.zshrc && exec zsh"
alias zshupdate="omz update"

alias cz="chezmoi"
alias lz="lazygit"
alias ld="lazydocker"
alias lj="lazyjournal"
alias op="opencode"

export PATH="$HOME/.local/bin:$PATH"

# Keep a sane PATH in all environments and remove duplicates.
typeset -U path PATH
path=(
  /home/linuxbrew/.linuxbrew/bin
  /home/linuxbrew/.linuxbrew/sbin
  "$HOME/.local/bin"
  "$HOME/.bun/bin"
  /usr/local/sbin
  /usr/local/bin
  /usr/sbin
  /usr/bin
  /sbin
  /bin
  $path
)
export PATH

# FZF theme git@github.com:catppuccin/fzf.git mocha
export FZF_DEFAULT_OPTS=" \
  --layout=reverse \
  --border \
  --height=40%  \
  --color=bg+:#313244,bg:#1E1E2E,spinner:#F5E0DC,hl:#F38BA8 \
  --color=fg:#CDD6F4,header:#F38BA8,info:#CBA6F7,pointer:#F5E0DC \
  --color=marker:#B4BEFE,fg+:#CDD6F4,prompt:#CBA6F7,hl+:#F38BA8 \
  --color=selected-bg:#45475A \
  --color=border:#6C7086,label:#CDD6F4"

# Machine-specific overrides. Only load the file that matches the current machine.
if [[ "$OSTYPE" == darwin* ]]; then
  [ -f ~/.zshrc.d/macos.zsh ] && source ~/.zshrc.d/macos.zsh
elif grep -qi microsoft /proc/version 2>/dev/null || [[ -n "$WSL_DISTRO_NAME" ]]; then
  [ -f ~/.zshrc.d/window-wsl.zsh ] && source ~/.zshrc.d/window-wsl.zsh
elif [[ "$OSTYPE" == linux* ]]; then
  [ -f ~/.zshrc.d/linux.zsh ] && source ~/.zshrc.d/linux.zsh
fi

[ -f ~/.zshrc.d/secrets.zsh ] && source ~/.zshrc.d/secrets.zsh
[ -f ~/.zshrc.d/local-machine.zsh ] && source ~/.zshrc.d/local-machine.zsh

zsh-defer +2 source ~/.zshrc.d/functions.zsh

