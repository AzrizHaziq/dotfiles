# --- Deferred: UI plugins (+1, first idle cycle) ---
# These affect typing feel so load as early as possible after prompt appears.
_load_ui_plugins() {
  eval "$(mise activate zsh)"
  eval "$(zoxide init zsh)"

  source $ZSH/plugins/zsh-vi-mode/zsh-vi-mode.plugin.zsh
  source $ZSH/custom/plugins/zsh-syntax-highlighting/zsh-syntax-highlighting.plugin.zsh
  source $ZSH/custom/plugins/zsh-autosuggestions/zsh-autosuggestions.zsh
  source $ZSH/custom/plugins/zsh-history-substring-search/zsh-history-substring-search.plugin.zsh
  source $ZSH/custom/plugins/zsh-fzf-history-search/zsh-fzf-history-search.plugin.zsh
  source $ZSH/custom/plugins/fzf-tab/fzf-tab.zsh  # must be last — overrides completion widgets

  # Keybinds that depend on the above plugins
  ZSH_AUTOSUGGEST_BUFFER_MAX_SIZE="20"
  ZSH_AUTOSUGGEST_USE_ASYNC=1

  bindkey '^P' history-substring-search-up
  bindkey '^N' history-substring-search-down
  bindkey '^Y' autosuggest-accept
}

# --- Deferred: env/tooling (+2, second idle cycle) ---
# Heavier init that doesn't affect typing feel.
_load_env_tools() {
  source $ZSH/custom/plugins/you-should-use/you-should-use.plugin.zsh

  # Platform-specific config, secrets, local overrides
  if [[ "$OSTYPE" == darwin* ]]; then
    [ -f ~/.zshrc.d/macos.zsh ] && source ~/.zshrc.d/macos.zsh
  elif grep -qi microsoft /proc/version 2>/dev/null || [[ -n "$WSL_DISTRO_NAME" ]]; then
    [ -f ~/.zshrc.d/window-wsl.zsh ] && source ~/.zshrc.d/window-wsl.zsh
  elif [[ "$OSTYPE" == linux* ]]; then
    [ -f ~/.zshrc.d/linux.zsh ] && source ~/.zshrc.d/linux.zsh
  fi
  [ -f ~/.zshrc.d/secrets.zsh ]       && source ~/.zshrc.d/secrets.zsh
  [ -f ~/.zshrc.d/local-machine.zsh ] && source ~/.zshrc.d/local-machine.zsh
  [ -f ~/.zshrc.d/functions.zsh ]     && source ~/.zshrc.d/functions.zsh
}

RPS1="%F{240}loading%f"
zsh-defer +1 _load_ui_plugins
zsh-defer +2 _load_env_tools
zsh-defer -c 'RPS1=""' # zsh defer loading done
