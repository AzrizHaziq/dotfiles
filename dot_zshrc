  --color=selected-bg:#45475A \
  --color=border:#6C7086,label:#CDD6F4"

# Machine-specific overrides. Only load the file that matches the current machine.
if [[ "$OSTYPE" == darwin* ]]; then
  [ -f ~/.zshrc.d/macos.zsh ] && source ~/.zshrc.d/macos.zsh
elif grep -qi microsoft /proc/version 2>/dev/null || [[ -n "$WSL_DISTRO_NAME" ]]; then
  [ -f ~/.zshrc.d/window-wsl.zsh ] && source ~/.zshrc.d/window-wsl.zsh
elif [[ "$OSTYPE" == linux* ]]; then
  [ -f ~/.zshrc.d/linux.zsh ] && source ~/.zshrc.d/linux.zsh
fi

[ -f ~/.zshrc.d/secrets.zsh ] && source ~/.zshrc.d/secrets.zsh
[ -f ~/.zshrc.d/local-machine.zsh ] && source ~/.zshrc.d/local-machine.zsh


function vi_mode_prompt_info() {
  MODE_INDICATOR="%F{${catppuccin_blue}}%f"
  INSERT_MODE_INDICATOR="%F{${catppuccin_green}}✎%f"

  case $ZVM_MODE in
    $ZVM_MODE_NORMAL) print -rn -- "$MODE_INDICATOR" ;;
    *) print -rn -- "$INSERT_MODE_INDICATOR" ;;
  esac
}

PROMPT+='$(vi_mode_prompt_info) '
RPS1="%F{240}loading%f"

function zvm_config() {
  ZVM_LINE_INIT_MODE=$ZVM_MODE_INSERT
  ZVM_SYSTEM_CLIPBOARD_ENABLED=true
  ZVM_INIT_MODE=sourcing           # Initialization style
}

function zvm_after_init() {
  zvm_bindkey viins '^P' up-line-or-beginning-search
  zvm_bindkey viins '^N' down-line-or-beginning-search
  bindkey -M viins '^Y' autosuggest-accept
}

function zvm_after_select_vi_mode() {
  # The "Refresh" Hook (Crucial for instant icon changes)
  zle reset-prompt 2>/dev/null
}

# Defer zoxide initialization - loads after prompt appears
if (( $+commands[zoxide] )); then
  zsh-defer +2 eval "$(zoxide init zsh)"
fi

# Defer mise activation - loads after prompt appears
if (( $+commands[mise] )); then
  zsh-defer +2 eval "$(mise activate zsh)"
fi

zsh-defer -c 'RPS1=""' # zsh defer loading done

