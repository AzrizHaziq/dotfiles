# Faster compinit with cache validation - only run once per day
autoload -Uz compinit
local dump_file="${ZDOTDIR:-$HOME}/.zcompdump"

# Only run compinit once a day (check if dump file is older than 24h)
if [[ -n $dump_file(#qNmh-24) ]]; then
  compinit -C -d "$dump_file"  # Use cache, skip check
else
  compinit -d "$dump_file"     # Full check once per day
  # Compile dump file in background for next time
  { zcompile "$dump_file" } &!
fi

# ============================================
# fzf-tab configuration (load before plugins)
# ============================================
# Set descriptions format to enable group support
zstyle ':completion:*:descriptions' format '[%d]'

# Enable filename colorizing
zstyle ':completion:*' list-colors ${(s.:.)LS_COLORS}

# Force zsh not to show completion menu (let fzf-tab handle it)
zstyle ':completion:*' menu no

# Use tmux floating popup for fzf-tab (requires tmux >= 3.2)
zstyle ':fzf-tab:*' fzf-command ftb-tmux-popup

# Preview directory contents when completing cd
zstyle ':fzf-tab:complete:cd:*' fzf-preview 'eza -1 --color=always $realpath'

# Git branch preview (git checkout, git switch, etc.)
zstyle ':fzf-tab:complete:git-(checkout|switch):*' fzf-preview 'git log --oneline -20 $word'

# Git commit log preview
zstyle ':fzf-tab:complete:git-commit:*' fzf-preview 'git log --oneline -20'

# Docker container/image preview
zstyle ':fzf-tab:complete:docker:argument-1:' fzf-preview 'docker ps --all --format "table {{.ID}}\t{{.Names}}\t{{.Status}}"'
zstyle ':fzf-tab:complete:docker-container:argument-1:' fzf-preview 'docker ps --all --format "table {{.ID}}\t{{.Names}}\t{{.Status}}"'

# npm script preview (show scripts from package.json)
zstyle ':fzf-tab:complete:npm:argument-1:' fzf-preview 'jq .scripts < package.json 2>/dev/null | grep -E "^\s+\"" | sed "s/\"//g"'
zstyle ':fzf-tab:complete:npm-run-script:argument-1:' fzf-preview 'jq .scripts < package.json 2>/dev/null'

# Disable sort for certain commands to preserve order
zstyle ':completion:*:git-checkout:*' sort false
zstyle ':completion:*:git-switch:*' sort false

# Custom fzf flags (optional, uncomment if needed)
# zstyle ':fzf-tab:*' fzf-flags --color=fg:1,fg+:2 --bind=tab:accept

export PATH="$HOME/.local/bin:$PATH"
export PATH="/home/azrizhaziq/.bun/bin:$PATH"

# Keep a sane PATH in all environments and remove duplicates.
typeset -U path PATH
path=(
  /home/linuxbrew/.linuxbrew/bin
  /home/linuxbrew/.linuxbrew/sbin
  "$HOME/.local/bin"
  "$HOME/.bun/bin"
  /usr/local/sbin
